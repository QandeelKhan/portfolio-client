.subheading {
    /* position: relative; */
    margin-bottom: 50px;
    text-align: center;
    font-size: 24px;
    line-height: 1em;
    letter-spacing: 0.5px;
    font-family: "Playfair Display", serif;
    font-weight: 700;
    color: var(--textPrimary);
}

/* ---Section About--- */

/* ---------ABOUT PAGE STARTS HERE----------- */

.aboutuser-icon {
    height: 50px;
    width: 50px;
}

.about-user-icon {
    height: 40px;
    width: 40px;
    fill: var(--primaryColor);
    /* background-color: #00a3e1; */
}

/* Light theme - use dark icon color */
[data-theme="light"] .about-user-icon {
    fill: var(--pageHeadingColor);
}

[data-theme="light"] .signature-area img {
    filter: invert(1) brightness(0);
}

.about-all-info {
    display: flex;
    justify-content: flex-start;
    width: 100%;
    height: auto;
    margin-bottom: 50px;
    margin-top: 35px;
}

.about-left-info {
    width: 60%;
    height: auto;
    padding: 15px;
}

.ui-ux-designer {
    color: var(--textPrimary);
    margin-bottom: 25px;
    font-size: 22px;
}

.about-right-info {
    width: 40%;
    height: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 15px;
}

.personel-info-heading {
    color: var(--textPrimary);
    font-family: "Playfair Display", serif;
    font-weight: 700;
    font-size: 22px;
    margin-bottom: 20px;
}

.personal-info-list {
    color: var(--textPrimary);
    line-height: 1em;
}

.personal-info-title {
    font-family: "Playfair Display", serif;
    font-size: 16px;
    font-weight: 700;
    /* letter-spacing: .5px; */
    position: relative;
    display: inline-block;
    margin-right: 15px;
    padding-bottom: 1px;
    border-bottom: 3px solid var(--primaryColor);
    color: var(--textPrimary);
}

.personal-info-value {
    font-size: 16px;
    /* font-weight: 700; */
    letter-spacing: 0.5px;
    position: relative;
    display: inline-block;
    margin-right: 15px;
    padding-bottom: 1px;
    color: var(--textPrimary);
    font-family: Arial, Helvetica, sans-serif;
}

.uiux-dummy-text {
    color: var(--textPrimary);
    font-family: Arial, Helvetica, sans-serif;
}

.personal-info-title ::after {
    content: " :";
    top: 0;
    position: absolute;
    right: -10px;
}

.about-right-info ul li {
    padding: 3px 0px;
}

.download-resume-btn {
    display: inline-block;
    color: var(--primaryColor);
    border: 2px solid var(--primaryColor);
    font-family: Arial, Helvetica, sans-serif;
    margin: 20px 0px;
    padding: 6px 18px;
    font-size: 14px;
    position: relative;
    transition: ease-out 0.5s;
    z-index: 1;
}

.download-resume-btn:hover {
    color: var(--whiteColor, white);
}

.download-resume-btn::after {
    content: "";
    left: 90%;
    right: 90%;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    background-color: var(--primaryColor);
    position: absolute;
    pointer-events: none;
    transition: 0.5s all ease;
}

.download-resume-btn:hover::after {
    left: 0;
    right: 0;
    width: 100%;
    opacity: 1;
    transition: 0.5s all ease;
    z-index: -1;
}

.signature-area img {
    width: 100%;
    height: 100px;
    /* transform: translateX(-180px); */
    filter: brightness(0) invert(1);
}

.signature-area {
    margin-top: 10px;
    z-index: 1;
}

/* Tablet responsive (769px - 1000px) - Personal info wraps freely and moves below about-left-info */
@media (min-width: 769px) and (max-width: 1000px) {
    .about-all-info {
        flex-direction: column;
        align-items: flex-start;
    }
    
    .about-left-info {
        width: 100%;
    }
    
    .about-right-info {
        width: 100%;
        align-items: flex-start;
    }
    
    .about-right-info ul {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 30px;
        width: 100%;
    }
    
    .about-right-info ul li {
        display: inline-flex;
        flex-direction: row;
        align-items: center;
        white-space: nowrap;
    }
    
    /* Heading takes full width */
    .personel-info-heading {
        width: 100%;
    }
    
    /* Download button takes full width on its own line */
    .about-right-info ul a.download-resume-btn {
        flex-basis: 100%;
        width: 100%;
        margin-top: 20px;
    }
}

@media (max-width: 768px) {
    .about-all-info {
        flex-wrap: wrap;
        flex-direction: column;
    }

    .about-right-info,
    .about-left-info {
        width: 90%;
    }

    .about-right-info {
        align-items: flex-start;
    }
}

/* iPad and tablet responsive - align columns to top */
@media (min-width: 1001px) and (max-width: 1100px) {
    .about-all-info {
        align-items: flex-start !important;
    }
}
