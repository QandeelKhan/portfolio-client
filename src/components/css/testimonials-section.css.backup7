/* -------Testimonial Section------- */
.testimonials-area {
    display: flex;
    flex-direction: column;
    margin-top: 60px;
    font-size: 14px;
    margin-bottom: 50px;
    overflow: visible;
    align-items: center;
}

.testimonials {
    display: flex;
    align-items: center;
    max-width: 1080px;
    width: 100%;
    padding: 0 20px;
    box-sizing: border-box;
}

.left-testimonial {
    margin-left: 20px;
    margin-right: 20px;
}

.right-testimonial {
    margin-left: 20px;
    margin-right: 20px;
}

.review-testimonial {
    display: flex;
    justify-content: space-around;
    align-items: center;
    background-color: var(--cardBackground);
    color: var(--textSecondary);
    padding: 20px 20px;
    border-bottom-right-radius: 50px;
    border-top-left-radius: 50px;
    margin-bottom: 20px;
    position: relative;
    font-family: Arial, Helvetica, sans-serif;
    box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.15);
    -webkit-box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.15);
    -moz-box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.15);
    border: 1px solid var(--borderLight);
}

/* Light theme testimonial styling */
[data-theme="light"] .review-testimonial {
    background-color: #E3E3E3;
    color: #2a2a2a;
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.1);
    border: none;
}

.testimonial-icon {
    margin-right: 25px;
}

.fa-comments {
    font-size: 40px;
    color: var(--primaryColor);
}

.review-testimonial:after {
    background-color: var(--cardBackground);
    content: "";
    left: 35px;
    bottom: -11px;
    width: 14px;
    height: 20px;
    opacity: 1;
    position: absolute;
    transform: rotate(45deg);
}

[data-theme="light"] .review-testimonial:after {
    background-color: #E3E3E3;
    border: none;
}

.person-info {
    display: flex;
    justify-content: flex-start;
    color: var(--textPrimary);
    padding: 0px 15px;
    max-height: 90px;
    overflow: hidden;
}

.reviewer-name {
    font-size: 18px;
    color: var(--textPrimary);
    font-weight: 600;
}

.reviewer-skills {
    font-family: Arial, Helvetica, sans-serif;
    color: var(--textSecondary);
}

.person-info img {
    border-bottom-right-radius: 18px;
    border-top-left-radius: 18px;
    width: 60px;
    height: auto;
}

.name-and-skill {
    display: flex;
    flex-direction: column;
    padding: 0px 15px;
}

/* Slider base styles - apply to all screen sizes */
.slick-slider {
    width: 100%;
}

.slick-list {
    overflow: hidden !important;
}

.slick-track {
    display: flex !important;
}

.slick-slide {
    height: auto;
}

.slick-slide > div {
    height: 100%;
}
/* Desktop and large laptops (>1400px) */
@media (min-width: 1401px) {
    .slick-list {
        overflow: hidden !important;
    }
    
    .testimonials {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 30px;
    }
}


/* Large tablets and laptops (iPad Pro 13, etc) */
@media (min-width: 1025px) and (max-width: 1400px) {
    .testimonials {
        max-width: 100%;
        width: 100%;
        margin: 0 auto;
        padding: 0 50px;
    }
    
    .slick-list {
        overflow: visible !important;
        padding: 0 !important;
        width: 100%;
    }
    
    .slick-track {
        display: flex !important;
        gap: 0;
        width: 100% !important;
    }
    
    .slick-slide {
        padding: 0 !important;
        width: 50% !important;
        min-width: 50% !important;
        max-width: 50% !important;
        flex: 0 0 50% !important;
        float: none !important;
    }
    
    /* Force the wrapper divs created by Slick to take full width */
    .slick-slide > div {
        width: 100% !important;
        height: 100%;
        padding: 0 15px;
        box-sizing: border-box;
    }
    
    .left-testimonial,
    .right-testimonial {
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box;
    }
    
    .review-testimonial {
        width: 100% !important;
        box-sizing: border-box;
    }
}

/* Medium tablets (iPad Pro mini, regular iPad) */
@media (min-width: 769px) and (max-width: 1024px) {
    .testimonials {
        max-width: 100%;
        width: 100%;
        margin: 0 auto;
        padding: 0 40px;
    }
    
    .slick-list {
        overflow: visible !important;
        padding: 0 !important;
        width: 100%;
    }
    
    .slick-track {
        display: flex !important;
        gap: 0;
        width: 100% !important;
    }
    
    .slick-slide {
        padding: 0 !important;
        width: 50% !important;
        min-width: 50% !important;
        max-width: 50% !important;
        flex: 0 0 50% !important;
        float: none !important;
    }
    
    /* Force the wrapper divs to take full width */
    .slick-slide > div {
        width: 100% !important;
        height: 100%;
        padding: 0 12px;
        box-sizing: border-box;
    }
    
    .left-testimonial,
    .right-testimonial {
        margin: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box;
    }
    
    .review-testimonial {
        padding: 16px 14px;
        width: 100% !important;
        box-sizing: border-box;
    }
    
    .testimonial-icon {
        margin-right: 12px;
    }
    
    .fa-comments {
        font-size: 32px;
    }
}

/* Mobile responsive - 1 card at a time with slider */
@media (max-width: 768px) {
    .testimonials-area {
        width: 100%;
        padding: 0 5px;
        overflow: hidden;
    }
    
    .testimonials {
        width: 100%;
        max-width: 100%;
    }
    
    .testimonials > div {
        width: 100% !important;
        max-width: 100% !important;
    }
    
    .slick-slider {
        width: 100%;
    }
    
    .slick-list {
        width: 100%;
        overflow: hidden;
        padding: 0 !important;
        margin: 0 !important;
    }
    
    .slick-track {
        display: flex !important;
    }
    
    .slick-slide {
        width: 100% !important;
    }
    
    .slick-slide > div {
        width: 100%;
        display: flex !important;
        justify-content: center;
    }
    
    .left-testimonial,
    .right-testimonial {
        width: calc(100% - 10px) !important;
        margin: 0 5px !important;
    }
    
    .review-testimonial {
        padding: 15px;
        width: 100%;
        box-sizing: border-box;
    }
    
    .testimonial-icon {
        margin-right: 10px;
    }
    
    .fa-comments {
        font-size: 30px;
    }
    
    .comment-review {
        font-size: 13px;
        line-height: 1.4;
    }
    
    .person-info {
        padding: 0 10px;
        max-height: none;
        overflow: visible;
    }
    
    .reviewer-name {
        font-size: 15px;
    }
    
    .person-info img {
        width: 50px;
        max-width: 50px;
        max-height: 60px;
    }
    
    .reviewer-skills {
        font-size: 12px;
        line-height: 1.3;
        display: block;
        white-space: normal;
        word-wrap: break-word;
    }
}
