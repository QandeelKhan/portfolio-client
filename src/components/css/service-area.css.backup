/* ---------SERVICES AREA CSS ---------- */
.service-area {
    display: flex;
    flex-direction: column;
    /* padding-top: 50px; */
}

.services {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    /* flex-wrap: wrap; */
    gap: 30px;
}

.skills {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    padding: 0px 10px;
}

/* Icon container - fixed height for alignment */
.skills svg {
    height: 60px;
    width: auto;
    max-width: 60px;
    margin-bottom: 10px;
}

.skills-heading {
    color: var(--textPrimary);
    font-size: 18px;
    font-weight: lighter;
    padding: 10px 0px;
    text-align: center;
    min-height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.skills-description {
    color: #d4d4d4;
    text-align: center;
    /* padding: 10px 0px; */
}

/* Light theme - skills description color */
[data-theme="light"] .skills-description {
    color: #555555;
}
/* Tablet view - 2x2 grid layout */
@media (min-width: 769px) and (max-width: 1000px) {
    .services {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: repeat(2, auto);
        gap: 30px;
        max-width: 900px;
        margin: 0 auto;
        padding: 0 20px;
        align-items: stretch;
    }
    
    .skills {
        width: 100%;
        padding: 20px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
}

/* Mobile view - single column */
@media (max-width: 768px) {
    .services {
        flex-wrap: wrap;
        flex-direction: column;
    }
    
    .skills {
        width: 100%;
        margin-bottom: 20px;
    }
}
