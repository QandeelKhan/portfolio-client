/* ============================================
   THEME VARIABLES - Dark & Light Mode Support
   ============================================ */
:root,
[data-theme="dark"] {
	--primaryColor: #00a3e1;
	--primaryLight: rgba(0, 163, 225, 0.1);
	--secondaryColor: #17181b;
	--backgroundColor: #2c2d2f;
	--cardBackground: #1e1f21;
	--borderText: #7a7a7a;
	--hoverColor: #fff;
	--blackColor: black;
	--successColor: #4caf50;
	--transition: all 0.3s ease;
	--textPrimary: #ffffff;
	--textSecondary: #d4d4d4;
	--borderLight: #3b3c43;
	--dividerColor: #444444;
}

[data-theme="light"] {
	--primaryColor: #0082b6;
	--primaryLight: rgba(0, 130, 182, 0.1);
	--secondaryColor: #f8f9fa;
	--backgroundColor: #FBFBFB;
	--cardBackground: #ffffff;
	--borderText: #d0d0d0;
	--hoverColor: #0082b6;
	--blackColor: #1a1a1a;
	--successColor: #4caf50;
	--transition: all 0.3s ease;
	--textPrimary: #1a1a1a;
	--textSecondary: #3a3a3a;
	--borderLight: #e5e5e5;
	--dividerColor: #dddddd;
}

/* ============================================
   MAIN RESUME CONTAINER - Single Wrapper
   ============================================ */
.main-resume-container {
	display: grid;
	grid-template-columns: 1fr 1fr;
	width: 100%;
	gap: 30px;
	margin-bottom: 50px;
	margin-top: 30px;
}

/* Experience and Education - Top Row */
.resume-left-info,
.resume-right-info {
	display: flex;
	flex-direction: column;
}

/* Skills - Bottom Row */
.resume-skills-left,
.resume-skills-right {
	display: flex;
	flex-direction: column;
	align-items: center;
	width: 100%;
	margin: 0px 20px;
}

/* Resume Section Headings */
.resume-heading {
	color: var(--textPrimary);
	font-family: "Playfair Display", serif;
	font-weight: 700;
	font-size: 22px;
	min-height: 40px;
	text-align: center;
	border-bottom: 2px solid var(--primaryColor);
	padding-bottom: 10px;
	margin-bottom: 25px;
	position: relative;
}

.resume-heading::after {
	content: "";
	position: absolute;
	bottom: -2px;
	left: 25%;
	width: 50%;
	height: 2px;
	background: linear-gradient(
		90deg,
		transparent,
		var(--primaryColor),
		transparent
	);
}

/* ============================================
   SKILLS SECTION STYLES
   ============================================ */
.design-skills {
	display: flex;
	flex-direction: column;
	align-items: center;
	width: 100%;
	height: auto;
}

.ist {
	display: flex;
	flex-direction: column;
	align-items: center;
	width: 100%;
	height: auto;
	padding: 7px 0px;
}

.coral-draw {
	display: flex;
	justify-content: space-between;
	align-items: center;
	width: 100%;
	height: auto;
	padding: 5px 0px;
}

.coral-draw span {
	font-size: 16px;
	color: var(--textPrimary);
}

.percentage {
	font-family: Arial, Helvetica, sans-serif;
	font-weight: bold;
}

[data-theme="light"] .percentage {
	color: #222222;
}

/* Percentage margins */
.per-95 { margin-right: 1%; }
.per-94 { margin-right: 2%; }
.per-93 { margin-right: 3%; }
.per-92 { margin-right: 4%; }
.per-91 { margin-right: 5%; }
.per-90 { margin-right: 6%; }
.per-88 { margin-right: 8%; }
.per-87 { margin-right: 9%; }

.graph-div {
	width: 100%;
	height: 10px;
	background-color: var(--skillBarBackground);
}

.fill {
	background-color: var(--skillBarFill);
}

/* Fill bars with arrow indicators */
.fill-95,
.fill-94,
.fill-93,
.fill-92,
.fill-91,
.fill-90,
.fill-88,
.fill-87 {
	height: 10px;
	position: relative;
}

.fill-95 { width: 95%; }
.fill-94 { width: 94%; }
.fill-93 { width: 93%; }
.fill-92 { width: 92%; }
.fill-91 { width: 91%; }
.fill-90 { width: 90%; }
.fill-88 { width: 88%; }
.fill-87 { width: 87%; }

.fill-95:after,
.fill-94:after,
.fill-93:after,
.fill-92:after,
.fill-91:after,
.fill-90:after,
.fill-88:after,
.fill-87:after {
	content: "";
	position: absolute;
	top: -10px;
	opacity: 1;
	right: -7px;
	border-left: 10px solid transparent;
	border-right: 10px solid transparent;
	border-bottom: 20px solid var(--skillBarFill);
}

/* Light theme - progress indicator arrows */
[data-theme="light"] .fill-95:after,
[data-theme="light"] .fill-94:after,
[data-theme="light"] .fill-93:after,
[data-theme="light"] .fill-92:after,
[data-theme="light"] .fill-91:after,
[data-theme="light"] .fill-90:after,
[data-theme="light"] .fill-88:after,
[data-theme="light"] .fill-87:after {
	border-bottom: 20px solid #222222;
}

/* ============================================
   RESPONSIVE LAYOUTS
   ============================================ */

/* Tablet view (769-1000px) - 2x2 grid maintained */
@media (min-width: 769px) and (max-width: 1000px) {
	.main-resume-container {
		grid-template-columns: 1fr 1fr;
		gap: 25px;
	}
	
	.resume-skills-left,
	.resume-skills-right {
		margin: 0px 10px;
	}
}

/* Mobile and small tablets - single column */
@media (max-width: 768px) {
	.main-resume-container {
		grid-template-columns: 1fr;
		gap: 40px;
	}

	.resume-heading {
		font-size: 20px;
	}
	
	.resume-skills-left,
	.resume-skills-right {
		margin: 0;
	}
}

