.form-input {
    width: 65%;
    margin-bottom: 50px;
}

/*  */
.form-input__relative {
    position: relative;
    margin-bottom: 5px;
}

.form-input__input {
    outline: none;
    width: 100%;
    height: 40px;
    background-color: transparent;
    /* Replace the border property with the outline property because it donot effect the layout by increment in size, because it's not on the edge of element just like border rather it's a little outside the edge of element and donot grow it's size toward inside of element that's why it's not disturbing inside layout of element*/
    outline: 2px solid rgb(155, 154, 154);
    color: var(--color-white-alpha);
    padding: 0px 10px;
    font-size: 15px;
    transition: outline-color 0.3s ease-in-out, color 0.3s ease-in-out;
}

/* Light theme input styling */
[data-theme="light"] .form-input__input {
    color: #1a1a1a;
    outline-color: #cccccc;
}

[data-theme="light"] .form-input__input:focus,
[data-theme="light"] .form-input__input:hover {
    outline-color: #999999;
}

.form-input__input--profile {
    height: 45px;
}

.form-input__input:focus {
    outline: 3px solid rgb(192, 190, 190);
}
.form-input__input:hover {
    outline: 3px solid rgb(192, 190, 190);
}

/* Floating Label Styles - Same as Contact Form */
.form-input__label {
    position: absolute;
    top: 0;
    left: 0;
    color: var(--textPrimary);
    display: flex;
    align-items: center;
    font-size: 1.4rem;
    font-weight: 500;
    cursor: text;
    color: var(--textSecondary);
    transition: top 0.3s ease, left 0.3s ease, font-size 0.3s ease, color 0.3s ease, margin 0.3s ease !important;
    pointer-events: none; /* Allow clicks to pass through to input field */
}

/* Light theme label styling */
[data-theme="light"] .form-input__label {
    color: #555555;
}

/* Float label up when input is focused, valid, or has content */
.form-input__input:focus + .form-input__label,
.form-input__input:valid + .form-input__label,
.form-input__input:not(:placeholder-shown) + .form-input__label {
    color: var(--primaryColor);
    font-size: 1rem;
    font-weight: 500;
    top: -25px;
    left: -5px;
    pointer-events: none;
}

/* Light theme - focused/moved label color */
[data-theme="light"] .form-input__input:focus + .form-input__label,
[data-theme="light"] .form-input__input:valid + .form-input__label,
[data-theme="light"] .form-input__input:not(:placeholder-shown) + .form-input__label {
    color: #555555;
}

/* Focus and hover outline colors */
[data-theme="light"] .form-input__input:focus {
    outline-color: #555555;
}

[data-theme="light"] .form-input__input:hover {
    outline-color: #999999;
}

/*  */

.button__show-hide-password {
    background: transparent;
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    padding: 0.25rem 0.75rem;
    border: none;
    color: rgb(107 114 128);
    transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 10;
}
.button__show-hide-password:focus {
    outline: 2px solid transparent;
    outline-offset: 2px;
}
.button__show-hide-password:hover {
    color: rgb(209 213 219);
}

/* Light theme password button */
[data-theme="light"] .button__show-hide-password {
    color: #555555;
}

[data-theme="light"] .button__show-hide-password:hover {
    color: #222222;
}
